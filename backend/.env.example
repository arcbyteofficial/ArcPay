# ArcPay Backend Configuration Template
# Copy this file to .env and fill in the values

# Server Port
PORT=3000

# Database URI (Default for local MongoDB)
MONGODB_URI=mongodb://localhost:27017/arcpay

# Security Secrets
JWT_SECRET=your_super_secret_key_here

# Razorpay Credentials (Optional for local testing)
RAZORPAY_KEY=rzp_test_...
RAZORPAY_SECRET=...
